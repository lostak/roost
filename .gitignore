.DS_Store
Thumbs.db
node_modules/

# Local files
Statements/

# Generated per-client policy spreadsheets (client PII — regenerated from statements)
Clients/

# Convention rules/reference documents (read-only source material, not app code)
Convention/

# Hosted edition runtime storage (SQLite DB + uploaded user PDFs — never commit user data)
data/
ROOST_DATA/
